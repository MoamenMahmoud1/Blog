DJANGO_SETTINGS_MODULE=mysite.settings
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-development-only-change-me
DJANGO_SECRET_KEY_FALLBACKS=

ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=http://localhost:8000

SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
DJANGO_LOG_LEVEL=INFO

DATABASE_URL=
DB_NAME=blog
DB_USER=blog
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

CACHE_URL=redis://127.0.0.1:6379/1
CACHE_KEY_PREFIX=django-blog

CELERY_BROKER_URL=redis://127.0.0.1:6380/0
CELERY_WORKER_CONCURRENCY=2

WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_LOG_LEVEL=info

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=replace-with-the-smtp-password
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=My Blog <noreply@example.com>
